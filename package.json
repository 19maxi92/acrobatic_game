{
  "name": "acrobatas-laplata",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "expo start --clear",
    "lint": "expo lint",
    "build:android": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "help": "echo '📱 COMANDOS DISPONIBLES:\n\n  npm start          - Iniciar en modo desarrollo (escanear QR)\n  npm run web        - Abrir en navegador\n  npm run android    - Ejecutar en emulador Android\n  npm run dev        - Iniciar limpiando cache\n\nPara más info, ver COMO_EJECUTAR.md'"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.20",
    "expo-constants": "~18.0.10",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
	"@babel/core": "^7.20.0"
  },
  "private": true
}
